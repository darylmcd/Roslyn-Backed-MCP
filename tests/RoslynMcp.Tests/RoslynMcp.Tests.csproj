<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RoslynMcp.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Microsoft.Build.Locator's MSBL001 guards the Host.Stdio startup path
         (MSBuildLocator.RegisterDefaults() needs the SDK's MSBuild, not a package copy).
         The test assembly never invokes the locator directly — it exercises Roslyn via
         fixtures that hand a pre-resolved MSBuildWorkspace to the code under test.
         Analyzer tests also load NuGet client assemblies through Microsoft.CodeAnalysis.Testing's
         reference-pack resolver, which trips MSBL001.
         The officially-supported escape hatch is this property from the locator targets. -->
    <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ProcessPipeWorkerProbe/ProcessPipeWorkerProbe.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../GitFixtureWorkerProbe/GitFixtureWorkerProbe.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <!-- Qualify copied project evaluation independently at the fork runner boundary. -->
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" />
    <!-- FakeTimeProvider — deterministic virtual clock for WorkspaceExecutionGateTests. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!-- ServerSurfaceCatalogAnalyzerTests: AnalyzerVerifier<T> harness for RMCP001/RMCP002.
         PrivateAssets="all" keeps the harness's Roslyn binaries scoped to the test host. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.MSTest" PrivateAssets="all" />
    <!-- ReferenceAssemblies.Net.Net80 requests this exact baseline at test runtime.
         Restore it up front so analyzer tests never need NuGet network access. -->
    <PackageDownload Include="Microsoft.NETCore.App.Ref" Version="[8.0.0]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RoslynMcp.Core\RoslynMcp.Core.csproj" />
    <ProjectReference Include="..\..\src\RoslynMcp.Host.Stdio\RoslynMcp.Host.Stdio.csproj" />
    <ProjectReference Include="..\..\src\RoslynMcp.Roslyn\RoslynMcp.Roslyn.csproj" />
    <!-- Reference the analyzer as a plain project reference so tests can instantiate it
         directly via typeof(ServerSurfaceCatalogAnalyzer). DO NOT set OutputItemType="Analyzer"
         here — we want the assembly on the test's compile path, not as an analyzer that would
         double-run when RoslynMcp.Host.Stdio's own transitive analyzer copy is already present. -->
    <ProjectReference Include="..\..\analyzers\ServerSurfaceCatalogAnalyzer\ServerSurfaceCatalogAnalyzer.csproj" />
  </ItemGroup>

  <Target Name="CopyGitFixtureWorkerProbe" AfterTargets="Build">
    <MSBuild Projects="../GitFixtureWorkerProbe/GitFixtureWorkerProbe.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="GitFixtureWorkerProbeTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <GitFixtureWorkerProbeOutputPrefix>@(GitFixtureWorkerProbeTargetPath->'%(RootDir)%(Directory)%(Filename)')</GitFixtureWorkerProbeOutputPrefix>
    </PropertyGroup>
    <ItemGroup>
      <GitFixtureWorkerProbeOutput Include="$(GitFixtureWorkerProbeOutputPrefix).*" />
    </ItemGroup>
    <Error Condition="!Exists('$(GitFixtureWorkerProbeOutputPrefix).dll')" Text="Git fixture worker probe output is missing: $(GitFixtureWorkerProbeOutputPrefix).dll" />
    <Error Condition="!Exists('$(GitFixtureWorkerProbeOutputPrefix).deps.json')" Text="Git fixture worker probe output is missing: $(GitFixtureWorkerProbeOutputPrefix).deps.json" />
    <Error Condition="!Exists('$(GitFixtureWorkerProbeOutputPrefix).runtimeconfig.json')" Text="Git fixture worker probe output is missing: $(GitFixtureWorkerProbeOutputPrefix).runtimeconfig.json" />
    <Copy SourceFiles="@(GitFixtureWorkerProbeOutput)" DestinationFolder="$(OutDir)ProcessProbes/GitFixtureWorkerProbe" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyProcessPipeWorkerProbe" AfterTargets="Build">
    <MSBuild Projects="../ProcessPipeWorkerProbe/ProcessPipeWorkerProbe.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="ProcessPipeWorkerProbeTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <ProcessPipeWorkerProbeOutputPrefix>@(ProcessPipeWorkerProbeTargetPath->'%(RootDir)%(Directory)%(Filename)')</ProcessPipeWorkerProbeOutputPrefix>
    </PropertyGroup>
    <ItemGroup>
      <ProcessPipeWorkerProbeOutput Include="$(ProcessPipeWorkerProbeOutputPrefix).*" />
    </ItemGroup>
    <Error Condition="!Exists('$(ProcessPipeWorkerProbeOutputPrefix).dll')" Text="Process pipe worker probe output is missing: $(ProcessPipeWorkerProbeOutputPrefix).dll" />
    <Error Condition="!Exists('$(ProcessPipeWorkerProbeOutputPrefix).deps.json')" Text="Process pipe worker probe output is missing: $(ProcessPipeWorkerProbeOutputPrefix).deps.json" />
    <Error Condition="!Exists('$(ProcessPipeWorkerProbeOutputPrefix).runtimeconfig.json')" Text="Process pipe worker probe output is missing: $(ProcessPipeWorkerProbeOutputPrefix).runtimeconfig.json" />
    <Copy SourceFiles="@(ProcessPipeWorkerProbeOutput)" DestinationFolder="$(OutDir)ProcessProbes/ProcessPipeWorkerProbe" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PrepareTestFixtures"
          BeforeTargets="VSTest"
          Condition="'$(TestFixturesPrepared)' != 'true'">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)../../eng/prepare-test-fixtures.ps1&quot;" />
  </Target>

</Project>
